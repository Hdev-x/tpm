<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- ============================================================
     [파일 읽기] BoardMapper.xml
     namespace = BoardMapper 인터페이스의 전체 경로.
     각 태그의 id = 인터페이스 메서드 이름과 1:1 연결된다.
     #{필드명} = 파라미터 객체의 getter를 호출해 PreparedStatement에 바인딩한다.

     [관련 테이블]
       BOARD : 게시글 본문 (BOARD_NO, BOARD_TITLE, BOARD_WRITER, BOARD_CONTENT, ...)
       FILE  : 첨부 파일 (FILE_NO, FILE_NAME, ORI_NAME, BOARD_NO)
     ============================================================ -->
<mapper namespace="com.tj.app.board.BoardMapper">

    <!-- ============================================================
         [재사용 SQL 조각] 검색 조건 WHERE 절.
         <sql id> 로 정의하고 <include refid> 로 여러 쿼리에서 재사용한다.

         <choose> = Java의 switch-if-elseif-else 와 동일한 흐름 제어.
           kind == 'v2' → BOARD_CONTENT(본문) 검색
           kind == 'v3' → BOARD_WRITER(작성자) 검색
           otherwise   → BOARD_TITLE(제목) 검색 (기본값)

         LIKE concat('%', #{search}, '%') → 앞뒤 와일드카드 포함 검색.
         ============================================================ -->
    <sql id="search_sql">
        WHERE
        <choose>
            <when test="kind == 'v2'">"BOARD_CONTENT"</when>
            <when test="kind == 'v3'">"BOARD_WRITER"</when>
            <otherwise>"BOARD_TITLE"</otherwise>
        </choose>
        LIKE concat('%', #{search}, '%')
    </sql>

    <!-- ============================================================
         검색 조건에 맞는 게시글 총 개수 조회.
         <include refid="search_sql"> → 위 search_sql 조각을 이 자리에 삽입한다.
         BoardService.list()에서 전체 페이지 수 계산에 사용한다.
         ============================================================ -->
    <select id="getCount" resultType="Long">
        SELECT COUNT("BOARD_NO") From "BOARD"
        <include refid="search_sql"></include>
    </select>

    <!-- ============================================================
         [resultMap] LEFT JOIN 결과(게시글 + 파일)를 BoardDTO에 매핑한다.

         resultType(단순 1:1)이 아닌 resultMap이 필요한 이유:
           게시글 1건에 파일이 N개 붙으면 JOIN 결과가 N행으로 늘어난다.
           MyBatis는 <id>의 값이 같은 행들을 하나의 BoardDTO로 합치고
           파일 정보를 <collection> 리스트에 모아준다.

         <id>         → PK 컬럼. 중복 행 식별 기준 (이 값이 같으면 같은 DTO).
         <result>     → 일반 컬럼 1:1 매핑.
         <collection> → 1:N 관계. FileDTO 객체 리스트로 묶어 boardDTO.list에 담는다.
                        ofType → 리스트 안의 각 항목 타입.
         ============================================================ -->
    <resultMap type="BoardDTO" id="detailResult">
        <id column="BOARD_NO" property="boardNo" />
        <result column="BOARD_TITLE" property="boardTitle" />
        <result column="BOARD_WRITER" property="boardWriter" />
        <result column="BOARD_CONTENT" property="boardContent" />
        <result column="BOARD_DATE" property="boardDate" />
        <result column="BOARD_VIEW" property="boardView" />
        <collection property="list" javaType="java.util.List"
            ofType="com.tj.app.common.file.FileDTO">
            <id column="FILE_NO" property="fileNo" />
            <result column="FILE_NAME" property="fileName" />
            <result column="ORI_NAME" property="oriName" />
        </collection>
    </resultMap>

    <!-- ============================================================
         게시글 등록.
         useGeneratedKeys="true" → DB가 자동 생성한 PK(BOARD_NO)를 꺼내
         keyProperty="boardNo"   → BoardDTO.boardNo 필드에 주입한다.
         BoardService에서 INSERT 직후 boardDTO.getBoardNo()로 파일과 연결할 때 쓴다.
         CURRENT_TIMESTAMP → DB 서버 시각으로 작성일시 자동 기록.
         BOARD_VIEW = 0    → 최초 조회수 0으로 초기화.
         ============================================================ -->
    <insert id="create" parameterType="BoardDTO"
        useGeneratedKeys="true" keyProperty="boardNo">
        INSERT INTO "BOARD" ("BOARD_TITLE",
        "BOARD_WRITER",
        "BOARD_CONTENT",
        "BOARD_DATE",
        "USERNAME",
        "BOARD_VIEW")
        VALUES
        (#{boardTitle}, #{boardWriter}, #{boardContent},
        CURRENT_TIMESTAMP, #{username}, 0)
    </insert>

    <!-- ============================================================
         게시글 목록 조회 (페이징 + 검색 조건 적용).
         resultMap="detailResult" → 파일 컬렉션까지 매핑 (목록에서는 files가 없어 빈 리스트).
         LIMIT #{perPage} OFFSET #{startNum} → Pager가 계산한 페이지 범위만 조회.
         ORDER BY BOARD_NO DESC → 최신 글이 위에 오도록 역순 정렬.
         ============================================================ -->
    <select id="list" resultMap="detailResult" parameterType="com.tj.app.common.pager.Pager">
        SELECT * FROM "BOARD"
        <include refid="search_sql"></include>
        ORDER BY "BOARD_NO" DESC
        LIMIT #{perPage} OFFSET #{startNum}
    </select>

    <!-- ============================================================
         최근 게시글 N건 조회 (메인·사이드바용).
         AS 별칭 → 컬럼명(BOARD_TITLE)을 필드명(boardTitle)으로 변환해 resultType으로 자동 매핑.
         필요한 컬럼만 SELECT해 응답 크기를 줄인다 (content 제외).
         ============================================================ -->
    <select id="listRecent" parameterType="int" resultType="com.tj.app.board.BoardDTO">
        SELECT
            "BOARD_NO"     AS boardNo,
            "BOARD_TITLE"  AS boardTitle,
            "BOARD_DATE"   AS boardDate,
            "BOARD_WRITER" AS boardWriter
        FROM "BOARD"
        ORDER BY "BOARD_NO" DESC
        LIMIT #{limit}
    </select>

    <!-- ============================================================
         게시글 상세 + 첨부 파일 목록을 한 번에 조회.
         LEFT JOIN FILE USING (BOARD_NO) → BOARD_NO가 같은 파일 행을 합친다.
         LEFT JOIN → 파일이 없어도 게시글은 반환된다 (files 리스트가 비어있음).
         USING (컬럼) → ON B.BOARD_NO = F.BOARD_NO 와 동일. 양쪽 컬럼명이 같을 때 사용.
         resultMap="detailResult" → 여러 파일 행을 하나의 BoardDTO.list로 묶어준다.
         ============================================================ -->
    <select id="detail" resultMap="detailResult">
        SELECT *
        FROM "BOARD" B
        LEFT JOIN "FILE" F USING ("BOARD_NO")
        WHERE "BOARD_NO" = #{boardNo}
    </select>

    <!-- ============================================================
         게시글 제목·본문 수정.
         BOARD_WRITER, BOARD_DATE, USERNAME은 수정 대상에서 제외한다.
         WHERE BOARD_NO → 특정 게시글만 수정.
         ============================================================ -->
    <update id="update">
        UPDATE "BOARD"
        SET
        "BOARD_TITLE"   = #{boardTitle},
        "BOARD_CONTENT" = #{boardContent}
        WHERE "BOARD_NO" = #{boardNo}
    </update>

    <!-- 게시글 삭제. 첨부 파일은 deleteFiles()로 먼저 삭제한 뒤 호출해야 한다. -->
    <delete id="delete">
        DELETE FROM "BOARD"
        WHERE "BOARD_NO" = #{boardNo}
    </delete>

    <!-- ============================================================
         첨부 파일 정보 저장.
         BOARD_NO → 방금 INSERT된 게시글과 파일을 연결하는 FK.
         파일 1건당 1번씩 호출된다 (BoardService에서 for 루프로 반복).
         ============================================================ -->
    <insert id="createFile">
        INSERT INTO "FILE" ("FILE_NAME", "ORI_NAME", "BOARD_NO")
        VALUES (#{fileName}, #{oriName}, #{boardNo})
    </insert>

    <!-- ============================================================
         특정 게시글의 첨부 파일 목록 조회.
         detail()과 달리 파일만 단독으로 가져온다 (BoardService.fileDetail() 용).
         ============================================================ -->
    <select id="detailFile" resultType="com.tj.app.common.file.FileDTO"
        parameterType="BoardDTO">
        SELECT * FROM "FILE"
        WHERE "BOARD_NO" = #{boardNo}
    </select>

    <!-- ============================================================
         특정 게시글의 첨부 파일 레코드 일괄 삭제.
         BoardService.delete()에서 게시글 삭제 전에 호출한다.
         FK 제약: FILE.BOARD_NO → BOARD.BOARD_NO 이므로 파일 먼저 삭제해야 한다.
         ============================================================ -->
    <delete id="deleteFiles" parameterType="BoardDTO">
        DELETE FROM "FILE"
        WHERE "BOARD_NO" = #{boardNo}
    </delete>

    <!-- ============================================================
         조회수 1 증가.
         BOARD_VIEW = BOARD_VIEW + 1 → 현재 값에 1을 더한다 (Java 없이 DB에서 처리).
         BoardService.detail()의 @Transactional 안에서 실행된다.
         ============================================================ -->
    <update id="updateViewCount">
        UPDATE "BOARD"
        SET "BOARD_VIEW" = "BOARD_VIEW" + 1
        WHERE "BOARD_NO" = #{boardNo}
    </update>

</mapper>
