<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tj.app.market.coin.CoinCommentMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="commentNo">
        INSERT INTO "COIN_COMMENT" ("SYMBOL", "CONTENT", "USERNAME", "CREATED_AT")
        VALUES (#{symbol}, #{content}, #{username}, CURRENT_TIMESTAMP)
    </insert>

    <select id="listBySymbol" resultType="com.tj.app.market.coin.CoinCommentDTO">
        SELECT
            "COMMENT_NO"  AS commentNo,
            "SYMBOL"      AS symbol,
            "CONTENT"     AS content,
            "USERNAME"    AS username,
            "CREATED_AT"  AS createdAt,
            "IMAGE_URL"   AS imageUrl
        FROM "COIN_COMMENT"
        WHERE "SYMBOL" = #{symbol}
        ORDER BY "CREATED_AT" DESC
        LIMIT 50
    </select>

</mapper>
