<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- ============================================================
     [파일 읽기] CoinMapper.xml
     namespace = CoinMapper 인터페이스의 전체 경로.

     [관련 테이블]
       COIN_WALLET  : 코인 지갑 (WALLET_NO, USERNAME, USDT_BALANCE)
       COIN_HOLDINGS: 보유 코인 (HOLDING_NO, USERNAME, COIN_CODE, COIN_COUNT, AVG_PRICE)
       COIN_ORDERS  : 코인 주문 이력 (ORDER_NO, USERNAME, COIN_CODE, ORDER_TYPE, ...)

     [보유 식별 기준] USERNAME + COIN_CODE 조합으로 특정 사용자의 특정 코인 보유를 식별한다.
     ============================================================ -->
<mapper namespace="com.tj.app.market.coin.order.CoinMapper">

    <!-- ============================================================
         코인 지갑 단건 조회.
         USERNAME으로 해당 사용자의 USDT 잔고를 가져온다.
         결과가 없으면 null → CoinService에서 null 체크 후 예외 처리.
         ============================================================ -->
    <select id="getWallet" resultType="com.tj.app.market.coin.order.CoinWalletDTO">
        SELECT * FROM "COIN_WALLET" WHERE "USERNAME" = #{username}
    </select>

    <!-- ============================================================
         코인 지갑 최초 생성 (회원가입 시 자동 호출).
         USDT_BALANCE = 100000.0 → 초기 지급 자금 (10만 USDT).
         WALLET_NO는 AUTO INCREMENT이므로 INSERT 목록에서 생략한다.
         ============================================================ -->
    <insert id="createWallet">
        INSERT INTO "COIN_WALLET" ("USERNAME", "USDT_BALANCE")
        VALUES (#{username}, 100000.0)
    </insert>

    <!-- ============================================================
         USDT 잔고 업데이트.
         매수 시 잔고 차감, 매도 시 잔고 증가, 환전 시에도 호출된다.
         USERNAME으로 해당 사용자의 지갑만 수정한다.
         ============================================================ -->
    <update id="updateWallet">
        UPDATE "COIN_WALLET"
        SET "USDT_BALANCE" = #{usdtBalance}
        WHERE "USERNAME" = #{username}
    </update>

    <!-- ============================================================
         특정 코인 보유 현황 단건 조회.
         USERNAME + COIN_CODE 조합으로 해당 사용자가 해당 코인을 갖고 있는지 확인한다.
         null이면 미보유(→ INSERT), 값이 있으면 보유 중(→ UPDATE 평단가 재계산).
         ============================================================ -->
    <select id="getHolding" resultType="com.tj.app.market.coin.order.CoinHoldingsDTO">
        SELECT * FROM "COIN_HOLDINGS"
        WHERE "USERNAME" = #{username} AND "COIN_CODE" = #{coinCode}
    </select>

    <!-- 해당 사용자의 전체 보유 코인 목록 조회. 사이드바·자산 계산에 사용한다. -->
    <select id="getHoldingList" resultType="com.tj.app.market.coin.order.CoinHoldingsDTO">
        SELECT * FROM "COIN_HOLDINGS" WHERE "USERNAME" = #{username}
    </select>

    <!-- ============================================================
         보유 코인 첫 매수 시 신규 행 삽입.
         AVG_PRICE = 최초 매수가 (이후 추가 매수 시 가중평균으로 재계산).
         COIN_COUNT는 소수점 허용 (예: 0.00312 BTC).
         ============================================================ -->
    <insert id="insertHolding">
        INSERT INTO "COIN_HOLDINGS" ("USERNAME", "COIN_CODE", "COIN_COUNT", "AVG_PRICE")
        VALUES (#{username}, #{coinCode}, #{coinCount}, #{avgPrice})
    </insert>

    <!-- ============================================================
         보유 수량·평단가 업데이트 (추가 매수 또는 일부 매도 후).
         CoinService에서 가중평균을 계산한 결과를 여기서 반영한다.
         USERNAME + COIN_CODE 두 조건 모두 일치해야 수정된다.
         ============================================================ -->
    <update id="updateHolding">
        UPDATE "COIN_HOLDINGS"
        SET "COIN_COUNT" = #{coinCount},
            "AVG_PRICE"  = #{avgPrice}
        WHERE "USERNAME" = #{username} AND "COIN_CODE" = #{coinCode}
    </update>

    <!-- ============================================================
         보유 코인 행 삭제 (전량 매도 시).
         CoinService.sell()에서 newCount == 0일 때 호출한다.
         ============================================================ -->
    <delete id="deleteHolding">
        DELETE FROM "COIN_HOLDINGS"
        WHERE "USERNAME" = #{username} AND "COIN_CODE" = #{coinCode}
    </delete>

    <!-- ============================================================
         코인 주문 이력 저장.
         ORDER_DATE = CURRENT_TIMESTAMP → 체결 시각 자동 기록.
         AVG_PRICE  → 매도 시 손익 계산을 위해 매수 평단가를 함께 저장한다.
         TARGET_PRICE → 현재 미사용. 지정가 기능 예비 필드.
         ============================================================ -->
    <insert id="insertOrder">
        INSERT INTO "COIN_ORDERS" (
            "USERNAME", "COIN_CODE", "ORDER_TYPE", "ORDER_PRICE",
            "ORDER_COUNT", "AVG_PRICE", "STATUS", "TARGET_PRICE", "ORDER_DATE"
        )
        VALUES (
            #{username}, #{coinCode}, #{orderType}, #{orderPrice},
            #{orderCount}, #{avgPrice}, #{status}, #{targetPrice}, CURRENT_TIMESTAMP
        )
    </insert>

    <!-- ============================================================
         체결 완료 주문 내역 조회 (STATUS = 'COMPLETED').
         ORDER BY ORDER_DATE DESC → 최신 체결 순으로 정렬.
         코인은 시장가 즉시 체결이므로 모든 주문이 COMPLETED 상태다.
         ============================================================ -->
    <select id="getOrderList" resultType="com.tj.app.market.coin.order.CoinOrdersDTO">
        SELECT * FROM "COIN_ORDERS"
        WHERE "USERNAME" = #{username} AND "STATUS" = 'COMPLETED'
        ORDER BY "ORDER_DATE" DESC
    </select>

    <!-- ============================================================
         미체결 주문 조회 (STATUS = 'PENDING') — 예비 기능, 현재 미사용.
         코인은 시장가 즉시 체결이므로 PENDING 상태가 생성되지 않는다.
         향후 지정가 기능 구현 시 사용할 자리.
         ============================================================ -->
    <select id="getPendingOrders" resultType="com.tj.app.market.coin.order.CoinOrdersDTO">
        SELECT * FROM "COIN_ORDERS"
        WHERE "USERNAME" = #{username} AND "STATUS" = 'PENDING'
        ORDER BY "ORDER_DATE" DESC
    </select>

    <!-- ============================================================
         주문 상태 업데이트 — 예비 기능, 현재 미사용.
         ORDER_NO(PK)로 특정 주문의 STATUS를 변경한다.
         (예: PENDING → COMPLETED, PENDING → CANCELLED)
         ============================================================ -->
    <update id="updateOrderStatus">
        UPDATE "COIN_ORDERS"
        SET "STATUS" = #{status}
        WHERE "ORDER_NO" = #{orderNo}
    </update>

    <!-- ============================================================
         특정 코인의 미체결 주문 일괄 취소 — 예비 기능, 현재 미사용.
         전량 매도 시 해당 코인에 걸려 있던 PENDING 주문을 모두 CANCELLED로 처리한다.
         USERNAME + COIN_CODE + STATUS='PENDING' 세 조건이 모두 일치하는 행만 수정.
         ============================================================ -->
    <update id="cancelPendingByCoin">
        UPDATE "COIN_ORDERS"
        SET "STATUS" = 'CANCELLED'
        WHERE "USERNAME" = #{username}
          AND "COIN_CODE" = #{coinCode}
          AND "STATUS" = 'PENDING'
    </update>

</mapper>
