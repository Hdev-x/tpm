<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- ============================================================
     [파일 읽기] OrderStockMapper.xml
     namespace = OrderStockMapper 인터페이스의 전체 경로.

     [관련 테이블]
       MEMBER  : 예수금 (CASH 컬럼) — 주식 지갑 역할 (별도 WALLET 테이블 없음)
       ASSETS  : 보유 주식 (ASSET_NO=종목코드, STOCK_COUNT, STOCK_PURCHASE, USERNAME)
       ORDER   : 주문 이력 (ORDER_ID, ORDER_TYPE, ORDER_PRICE, ..., STATUS)
       STOCK   : 종목 마스터 (STOCK_NO, STOCK_CODE, STOCK_NAME)

     [LPAD 패턴] 주식 코드는 6자리 문자열 (예: "005930").
       DB에 CHAR(6) 또는 INT로 저장되어 있을 수 있어 앞자리 0이 소실될 수 있다.
       LPAD("ASSET_NO", 6, '0') = LPAD(#{stockCode}, 6, '0') 로 양쪽을 맞춰 비교한다.

     [TRIM 패턴] CHAR 타입 컬럼은 값이 짧으면 뒤에 공백이 채워진다.
       STATUS 컬럼이 CHAR로 선언된 경우 'PENDING  ' 처럼 공백이 붙어 비교가 실패할 수 있다.
       TRIM("STATUS") 로 공백을 제거하고 비교한다.
     ============================================================ -->
<mapper namespace="com.tj.app.market.stock.order.OrderStockMapper">

    <!-- ============================================================
         예수금(CASH) 조회.
         MEMBER 테이블의 CASH 컬럼에서 직접 읽는다 (별도 지갑 테이블 없음).
         resultType="long" → CASH는 원화 단위 정수이므로 long.
         ============================================================ -->
    <select id="getWallet" resultType="long">
        SELECT "CASH"
        FROM "MEMBER"
        WHERE "USERNAME" = #{username}
    </select>

    <!-- ============================================================
         예수금 업데이트.
         OrderStockService에서 매수 시 차감, 매도·취소 시 환불한 값을 그대로 SET한다.
         ============================================================ -->
    <update id="updateWallet">
        UPDATE "MEMBER"
        SET "CASH" = #{cash}
        WHERE "USERNAME" = #{username}
    </update>

    <!-- ============================================================
         특정 종목 보유 현황 단건 조회.
         LPAD → 6자리로 맞춰 ASSET_NO(종목코드)와 비교한다.
         resultType="map" → STOCK_COUNT, STOCK_PURCHASE 두 컬럼만 Map으로 반환.
         null이면 미보유 → insertHolding(), 있으면 보유 중 → updateHolding().
         ============================================================ -->
    <select id="getHolding" resultType="map">
        SELECT "STOCK_COUNT", "STOCK_PURCHASE"
        FROM "ASSETS"
        WHERE "USERNAME" = #{username}
          AND LPAD("ASSET_NO", 6, '0') = LPAD(#{stockCode}, 6, '0')
    </select>

    <!-- ============================================================
         보유 주식 전체 목록 조회.
         JOIN STOCK → 종목코드(ASSET_NO)로 종목명(STOCK_NAME)을 함께 가져온다.
         ON ASSET_NO = STOCK_CODE → ASSETS.ASSET_NO와 STOCK.STOCK_CODE로 연결.
         resultType="map" → 여러 컬럼을 Map<String, Object>로 반환.
         ============================================================ -->
    <select id="getHoldingList" resultType="map">
        SELECT
            A."ASSET_NO",
            A."STOCK_COUNT",
            A."STOCK_PURCHASE",
            A."USERNAME",
            S."STOCK_NO",
            S."STOCK_CODE",
            S."STOCK_NAME"
        FROM "ASSETS" A
        JOIN "STOCK" S ON A."ASSET_NO" = S."STOCK_CODE"
        WHERE A."USERNAME" = #{username}
    </select>

    <!-- ============================================================
         보유 주식 신규 삽입 (처음 매수).
         ASSET_NO = 종목코드 (PK 역할).
         jdbcType=VARCHAR → MyBatis가 null 처리 시 타입을 명시해야 하는 경우에 사용.
                            stockCode가 String이므로 VARCHAR로 지정한다.
         ============================================================ -->
    <insert id="insertHolding" parameterType="com.tj.app.market.stock.order.OrderStockDTO">
        INSERT INTO "ASSETS" ("ASSET_NO", "STOCK_COUNT", "STOCK_PURCHASE", "USERNAME")
        VALUES (#{stockCode, jdbcType=VARCHAR}, #{orderCount}, #{orderPrice}, #{username})
    </insert>

    <!-- ============================================================
         보유 수량·평균 단가 업데이트 (추가 매수 또는 일부 매도 후).
         OrderStockService에서 가중평균을 계산한 결과를 여기서 반영한다.
         LPAD → 6자리 코드 비교.
         ============================================================ -->
    <update id="updateHolding" parameterType="com.tj.app.market.stock.order.OrderStockDTO">
        UPDATE "ASSETS"
        SET "STOCK_COUNT"    = #{orderCount},
            "STOCK_PURCHASE" = #{orderPrice}
        WHERE "USERNAME" = #{username}
          AND LPAD("ASSET_NO", 6, '0') = LPAD(#{stockCode}, 6, '0')
    </update>

    <!-- ============================================================
         보유 주식 행 삭제 (전량 매도 시).
         LPAD → 6자리 코드 비교.
         ============================================================ -->
    <delete id="deleteHolding">
        DELETE FROM "ASSETS"
        WHERE "USERNAME" = #{username}
          AND LPAD("ASSET_NO", 6, '0') = LPAD(#{stockCode}, 6, '0')
    </delete>

    <!-- ============================================================
         주문 이력 삽입.
         useGeneratedKeys="true" → DB 생성 PK를 keyProperty="orderId"에 주입.
         ORDER_DATE = CURRENT_TIMESTAMP → 주문 시각 자동 기록.

         STOCK_NO 서브쿼리:
           ORDER 테이블에는 STOCK_NO(FK)가 필요하지만 파라미터에는 STOCK_CODE만 있다.
           서브쿼리로 STOCK 테이블에서 해당 종목의 STOCK_NO를 조회해 삽입한다.
         ============================================================ -->
    <insert id="insertOrder"
        parameterType="com.tj.app.market.stock.order.OrderStockDTO"
        useGeneratedKeys="true" keyProperty="orderId">
        INSERT INTO "ORDER" (
            "ORDER_TYPE", "ORDER_PRICE", "ORDER_COUNT", "ORDER_DATE",
            "STOCK_NO", "STOCK_CODE", "USERNAME", "STATUS"
        )
        VALUES (
            #{orderType}, #{orderPrice}, #{orderCount}, CURRENT_TIMESTAMP,
            (SELECT "STOCK_NO" FROM "STOCK" WHERE "STOCK_CODE" = #{stockCode, jdbcType=VARCHAR}),
            #{stockCode, jdbcType=VARCHAR},
            #{username},
            #{status}
        )
    </insert>

    <!-- ============================================================
         전체 주문 내역 조회 (체결·취소 포함).
         JOIN STOCK → 종목명(STOCK_NAME)을 함께 가져온다.
         TRIM("STATUS") → CHAR 타입 STATUS의 뒤 공백 제거 후 반환.
         ORDER BY ORDER_DATE DESC → 최신 주문이 위.
         resultType="map" → 컬럼별 Map으로 반환.
         ============================================================ -->
    <select id="getOrderList" resultType="map">
        SELECT
            O."ORDER_ID", O."ORDER_TYPE", O."ORDER_PRICE", O."ORDER_COUNT",
            O."ORDER_DATE", O."STOCK_NO", O."STOCK_CODE", O."USERNAME",
            TRIM(O."STATUS") AS "STATUS",
            S."STOCK_NAME"
        FROM "ORDER" O
        JOIN "STOCK" S ON O."STOCK_NO" = S."STOCK_NO"
        WHERE O."USERNAME" = #{username}
        ORDER BY O."ORDER_DATE" DESC
    </select>

    <!-- ============================================================
         미체결 주문 목록 조회 (STATUS = 'PENDING').
         TRIM(STATUS) = 'PENDING' → CHAR 타입 공백 제거 후 비교.
         OrderScheduler에서 체결 가능 주문을 찾을 때 사용한다.
         ============================================================ -->
    <select id="getPendingOrders" resultType="map">
        SELECT
            O."ORDER_ID", O."ORDER_TYPE", O."ORDER_PRICE", O."ORDER_COUNT",
            O."ORDER_DATE", O."STOCK_NO", O."STOCK_CODE", O."USERNAME",
            TRIM(O."STATUS") AS "STATUS",
            S."STOCK_NAME"
        FROM "ORDER" O
        JOIN "STOCK" S ON O."STOCK_NO" = S."STOCK_NO"
        WHERE O."USERNAME" = #{username}
          AND TRIM(O."STATUS") = 'PENDING'
        ORDER BY O."ORDER_DATE" DESC
    </select>

    <!-- ============================================================
         특정 주문을 CANCELLED 상태로 변경.
         ORDER_ID(PK)로 단건 취소 처리한다.
         OrderStockService.cancelStockOrder()에서 BUY 취소 시 예수금 환불 후 호출한다.
         ============================================================ -->
    <update id="cancelPendingByStock">
        UPDATE "ORDER"
        SET "STATUS" = 'CANCELLED'
        WHERE "ORDER_ID" = #{orderNo}
    </update>

    <!-- ============================================================
         전체 미체결 주문 조회 (사용자 구분 없음) — OrderScheduler 전용.
         모든 사용자의 PENDING 주문을 오래된 순(ORDER_DATE ASC)으로 가져온다.
         OrderScheduler가 10초마다 이 목록을 순회하며 체결 조건을 확인한다.
         AS 별칭 → OrderStockDTO 필드명으로 매핑 (resultType="OrderStockDTO").
         ============================================================ -->
    <select id="getAllPendingOrders" resultType="com.tj.app.market.stock.order.OrderStockDTO">
        SELECT
            "ORDER_ID"   AS "orderId",
            "ORDER_TYPE" AS "orderType",
            "ORDER_PRICE" AS "orderPrice",
            "ORDER_COUNT" AS "orderCount",
            "STOCK_CODE"  AS "stockCode",
            "USERNAME"    AS "username",
            TRIM("STATUS") AS "status"
        FROM "ORDER"
        WHERE TRIM("STATUS") = 'PENDING'
        ORDER BY "ORDER_DATE" ASC
    </select>

    <!-- ============================================================
         주문 상태 업데이트 (PENDING → COMPLETED 또는 CANCELLED).
         ORDER_ID(PK)로 특정 주문의 STATUS를 변경한다.
         OrderScheduler에서 조건 충족 시 COMPLETED로, 취소 시 CANCELLED로 업데이트한다.
         ============================================================ -->
    <update id="updateOrderStatus" parameterType="com.tj.app.market.stock.order.OrderStockDTO">
        UPDATE "ORDER"
        SET "STATUS" = #{status}
        WHERE "ORDER_ID" = #{orderId}
    </update>

    <!-- ============================================================
         주문 단건 조회 (ORDER_ID로).
         cancelStockOrder()에서 취소 요청한 주문이 실제로 해당 사용자의 것인지
         소유권을 확인할 때 사용한다.
         ============================================================ -->
    <select id="getOrderById" resultType="com.tj.app.market.stock.order.OrderStockDTO">
        SELECT
            "ORDER_ID"    AS "orderId",
            "ORDER_TYPE"  AS "orderType",
            "ORDER_PRICE" AS "orderPrice",
            "ORDER_COUNT" AS "orderCount",
            "STOCK_CODE"  AS "stockCode",
            "USERNAME"    AS "username",
            "STATUS"      AS "status"
        FROM "ORDER"
        WHERE "ORDER_ID" = #{orderId}
    </select>

</mapper>
