<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

  <mapper namespace="com.tj.app.member.MemberMapper">
  
   <insert id="create">
   INSERT INTO "MEMBER"
   VALUES (#{username}, #{name}, #{password}, #{cash})
   </insert>
   
   <select id="read">
   	SELECT * FROM "MEMBER"
   	WHERE "USERNAME" = #{username}
   </select>
  
  <update id="update">
  	UPDATE "MEMBER" SET ("NAME", "CASH")
  	VALUES (#{name}, #{cash})
  </update> 
  
  <delete id="delete">
  	DELETE FROM MEMBER
  	WHERE "USERNAME" = #{username}
  </delete>
  
  </mapper>