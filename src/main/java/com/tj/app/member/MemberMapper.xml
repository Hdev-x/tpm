<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- ============================================================
     [파일 읽기] MemberMapper.xml
     namespace = MemberMapper 인터페이스의 전체 경로.
     각 태그의 id = 인터페이스 메서드 이름과 1:1 연결된다.
     #{필드명} = MemberDTO의 getter를 호출해 값을 바인딩한다.

     [관련 테이블]
       MEMBER : 회원 정보 (USERNAME, NAME, PASSWORD, CASH, EMAIL, ROLE_NO)
       ROLE   : 권한 정보 (ROLE_NO, ROLE_NAME)
     ============================================================ -->
<mapper namespace="com.tj.app.member.MemberMapper">

    <!-- ============================================================
         회원가입 INSERT.
         CASH     = 2억 원(200,000,000)으로 초기 지급.
         ROLE_NO  = 2 → 일반 사용자 권한(ROLE_USER) 고정 할당.
                     (관리자는 ROLE_NO=1로 별도 설정한다.)
         USERNAME = PK이므로 중복 시 DB 레벨에서 오류가 발생한다.
         ============================================================ -->
    <insert id="create">
        INSERT INTO "MEMBER" ("USERNAME", "NAME", "PASSWORD", "CASH", "EMAIL", "ROLE_NO")
        VALUES (#{username}, #{name}, #{password}, 200000000, #{email}, 2)
    </insert>

    <!-- ============================================================
         USERNAME 단순 조회.
         현재 MemberServiceImpl에서는 login()이 대신 사용되어 호출되지 않는다.
         resultType="MemberDTO" → 컬럼명을 MemberDTO 필드에 자동 매핑.
         ============================================================ -->
    <select id="read" resultType="MemberDTO">
        SELECT * FROM "MEMBER"
        WHERE "USERNAME" = #{username}
    </select>

    <!-- ============================================================
         이름과 예수금만 수정.
         USERNAME(PK)을 기준으로 해당 행을 찾아 NAME, CASH만 변경한다.
         PASSWORD, EMAIL, ROLE_NO는 수정 대상에서 제외한다.
         ============================================================ -->
    <update id="update">
        UPDATE "MEMBER"
        SET
            "NAME" = #{name},
            "CASH" = #{cash}
        WHERE "USERNAME" = #{username}
    </update>

    <!-- 회원 탈퇴. USERNAME(PK)을 기준으로 행을 삭제한다. -->
    <delete id="delete">
        DELETE FROM "MEMBER"
        WHERE "USERNAME" = #{username}
    </delete>

    <!-- ============================================================
         [resultMap] JOIN 결과(회원 + 권한)를 MemberDTO에 매핑한다.

         resultType(단순 1:1)이 아닌 resultMap을 쓰는 이유:
           MEMBER와 ROLE을 JOIN하면 1:1이지만, 향후 1:N 권한 구조로 확장 가능하도록
           <collection>으로 roles 리스트에 담는다.

         <id>         → PK 컬럼. 중복 행 식별 기준.
         <result>     → 일반 컬럼 1:1 매핑.
         <collection> → 1:N 관계. RoleDTO 리스트로 묶어 MemberDTO.roles에 담는다.
                        ofType="RoleDTO" → 리스트 안의 각 항목 타입.
         ============================================================ -->
    <resultMap type="MemberDTO" id="memberResult">
        <id column="USERNAME" property="username" />
        <result column="NAME" property="name" />
        <result column="PASSWORD" property="password" />
        <result column="CASH" property="cash" />
        <result column="EMAIL" property="email"/>
        <collection property="roles" ofType="RoleDTO">
            <id column="ROLE_NO" property="roleNo" />
            <result column="ROLE_NAME" property="roleName" />
        </collection>
    </resultMap>

    <!-- ============================================================
         로그인·회원 조회 핵심 쿼리.
         MEMBER + ROLE을 LEFT JOIN해 권한 정보(ROLE_NAME)까지 한 번에 가져온다.
         LEFT JOIN → ROLE이 없어도 회원 정보는 반환된다 (roles 리스트는 비어있음).
         결과는 memberResult로 매핑되어 MemberDTO.roles 리스트가 채워진다.

         MemberServiceImpl.login()에서 호출 → Spring Security가 roles를
         GrantedAuthority 목록으로 변환해 인증 처리에 사용한다.
         ============================================================ -->
    <select id="login" resultMap="memberResult">
        SELECT
            M."USERNAME", M."NAME", M."PASSWORD", M."CASH", M."EMAIL",
            R."ROLE_NO", R."ROLE_NAME"
        FROM "MEMBER" M
        LEFT JOIN "ROLE" R ON M."ROLE_NO" = R."ROLE_NO"
        WHERE M."USERNAME" = #{username}
    </select>

</mapper>
