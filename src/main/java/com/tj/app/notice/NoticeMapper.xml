<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- ============================================================
     [파일 읽기] NoticeMapper.xml
     namespace = NoticeMapper 인터페이스의 전체 경로.

     [관련 테이블]
       NOTICE : 공지사항 본문 (NOTICE_NO, NOTICE_TITLE, NOTICE_WRITER, ...)
       FILE   : 첨부 파일 (FILE_NO, FILE_NAME, ORI_NAME, NOTICE_NO)

     [BoardMapper.xml과의 차이]
       list    : WHERE·페이징 없이 전체 조회 (공지사항은 소량이므로 페이징 미적용)
       detail  : resultMap으로 파일 컬렉션 매핑 (BoardMapper와 동일한 패턴)
       좋아요·댓글 관련 쿼리 없음
     ============================================================ -->
<mapper namespace="com.tj.app.notice.NoticeMapper">

    <!-- ============================================================
         [resultMap] LEFT JOIN 결과(공지사항 + 파일)를 NoticeDTO에 매핑한다.

         공지사항 1건에 파일이 N개 붙으면 JOIN 결과가 N행으로 늘어난다.
         <id>의 값이 같은 행들을 하나의 NoticeDTO로 합치고,
         파일 정보를 <collection> 리스트에 모아 noticeDTO.list에 담는다.

         <id>         → PK 컬럼. 중복 행 식별 기준.
         <result>     → 일반 컬럼 1:1 매핑.
         <collection> → 1:N 관계. FileDTO 리스트로 묶어 noticeDTO.list에 담는다.
         ============================================================ -->
    <resultMap type="NoticeDTO" id="detailResult">
        <id column="NOTICE_NO" property="noticeNo" />
        <result column="NOTICE_TITLE" property="noticeTitle" />
        <result column="NOTICE_WRITER" property="noticeWriter" />
        <result column="NOTICE_CONTENT" property="noticeContent" />
        <result column="NOTICE_DATE" property="noticeDate" />
        <result column="NOTICE_VIEW" property="noticeView" />
        <collection property="list" javaType="java.util.List"
            ofType="com.tj.app.common.file.FileDTO">
            <id column="FILE_NO" property="fileNo" />
            <result column="FILE_NAME" property="fileName" />
            <result column="ORI_NAME" property="oriName" />
        </collection>
    </resultMap>

    <!-- ============================================================
         공지사항 등록.
         useGeneratedKeys="true" → DB가 생성한 NOTICE_NO를 noticeDTO.noticeNo에 주입.
         keyProperty="noticeNo"  → 파일 저장 시 noticeNo를 FK로 연결하는 데 사용.
         NOTICE_VIEW = 0         → 최초 조회수 0으로 초기화.
         CURRENT_TIMESTAMP       → 작성 일시 자동 기록.
         ============================================================ -->
    <insert id="create" parameterType="noticeDTO"
        useGeneratedKeys="true" keyProperty="noticeNo">
        INSERT INTO "NOTICE" (
            "NOTICE_TITLE", "NOTICE_WRITER", "NOTICE_CONTENT",
            "NOTICE_DATE", "USERNAME", "NOTICE_VIEW"
        )
        VALUES (
            #{noticeTitle}, #{noticeWriter}, #{noticeContent},
            CURRENT_TIMESTAMP, #{username}, 0
        )
    </insert>

    <!-- ============================================================
         공지사항 전체 목록 조회 (페이징 없음).
         BoardMapper.list()와 달리 WHERE·LIMIT 없이 모든 공지사항을 반환한다.
         공지사항 수가 적다는 가정 하에 전체 조회를 사용한다.
         ============================================================ -->
    <select id="list" resultType="NoticeDTO">
        SELECT * FROM "NOTICE"
    </select>

    <!-- ============================================================
         최근 공지사항 N건 조회 (메인 페이지·사이드바용).
         AS 별칭 → 컬럼명을 필드명으로 변환해 resultType 자동 매핑.
         필요한 컬럼만 SELECT (content 제외).
         NOTICE_VIEW 포함 → 메인 화면에서 조회수 표시에 사용.
         ============================================================ -->
    <select id="listRecent" parameterType="int" resultType="com.tj.app.notice.NoticeDTO">
        SELECT
            "NOTICE_NO"     AS noticeNo,
            "NOTICE_TITLE"  AS noticeTitle,
            "NOTICE_DATE"   AS noticeDate,
            "NOTICE_WRITER" AS noticeWriter,
            "NOTICE_VIEW"   AS noticeView
        FROM "NOTICE"
        ORDER BY "NOTICE_NO" DESC
        LIMIT #{limit}
    </select>

    <!-- ============================================================
         공지사항 상세 + 첨부 파일 목록을 한 번에 조회.
         LEFT JOIN FILE USING (NOTICE_NO) → NOTICE_NO가 같은 파일 행을 합친다.
         LEFT JOIN → 파일이 없어도 공지사항은 반환된다.
         USING (NOTICE_NO) → ON N.NOTICE_NO = F.NOTICE_NO 와 동일.
         resultMap="detailResult" → 여러 파일 행을 하나의 NoticeDTO.list로 묶어준다.
         ============================================================ -->
    <select id="detail" resultMap="detailResult">
        SELECT *
        FROM "NOTICE" N
        LEFT JOIN "FILE" F USING ("NOTICE_NO")
        WHERE "NOTICE_NO" = #{noticeNo}
    </select>

    <!-- ============================================================
         공지사항 제목·본문 수정.
         NOTICE_WRITER, NOTICE_DATE, USERNAME은 수정 대상에서 제외한다.
         ============================================================ -->
    <update id="update">
        UPDATE "NOTICE"
        SET
            "NOTICE_TITLE"   = #{noticeTitle},
            "NOTICE_CONTENT" = #{noticeContent}
        WHERE "NOTICE_NO" = #{noticeNo}
    </update>

    <!-- 공지사항 삭제. 첨부 파일은 deleteFiles()로 먼저 삭제한 뒤 호출해야 한다. -->
    <delete id="delete">
        DELETE FROM "NOTICE"
        WHERE "NOTICE_NO" = #{noticeNo}
    </delete>

    <!-- ============================================================
         첨부 파일 정보 저장.
         NOTICE_NO → 방금 INSERT된 공지사항과 파일을 연결하는 FK.
         파일 1건당 1번씩 호출된다 (NoticeService에서 for 루프로 반복).
         ============================================================ -->
    <insert id="createFile">
        INSERT INTO "FILE" ("FILE_NAME", "ORI_NAME", "NOTICE_NO")
        VALUES (#{fileName}, #{oriName}, #{noticeNo})
    </insert>

    <!-- ============================================================
         특정 공지사항의 첨부 파일 목록 조회.
         detail()과 달리 파일만 단독으로 가져온다 (NoticeService.fileDetail() 용).
         ============================================================ -->
    <select id="detailFile" resultType="com.tj.app.common.file.FileDTO"
        parameterType="NoticeDTO">
        SELECT * FROM "FILE"
        WHERE "NOTICE_NO" = #{noticeNo}
    </select>

    <!-- ============================================================
         특정 공지사항의 첨부 파일 레코드 일괄 삭제.
         NoticeService.delete()에서 공지사항 삭제 전에 호출한다.
         FK 제약: FILE.NOTICE_NO → NOTICE.NOTICE_NO 이므로 파일 먼저 삭제해야 한다.
         ============================================================ -->
    <delete id="deleteFiles" parameterType="NoticeDTO">
        DELETE FROM "FILE"
        WHERE "NOTICE_NO" = #{noticeNo}
    </delete>

    <!-- ============================================================
         조회수 1 증가.
         NOTICE_VIEW = NOTICE_VIEW + 1 → 현재 값에 1을 더한다.
         NoticeService.detail() 호출 시 함께 실행된다.
         ============================================================ -->
    <update id="updateViewCount">
        UPDATE "NOTICE"
        SET "NOTICE_VIEW" = "NOTICE_VIEW" + 1
        WHERE "NOTICE_NO" = #{noticeNo}
    </update>

</mapper>
